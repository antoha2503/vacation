<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!--    FORM-->
    <record id="vacation_empl_form" model="ir.ui.view">
        <field name="name">vacation.empl.form</field>
        <field name="model">vacation.empl</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="start_date" widget="daterange" options="{'related_end_date': 'end_date'}"/>
                        <field name="end_date" />
                        <field name="type_statement"/>
                        <field name="number_days"/>
                    </group>
                </sheet>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="name_company"/>
                        <field name="parent_id"/>
                        <field name="department_id" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_open_vacation" string="Попередній перегляд" type="object" class="btn-primary" />
                    <button name="action_print" string="Завантажити заяву" type="object" class="btn-primary" />
                    <button string="Закрити" class="oe_link" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

</odoo>